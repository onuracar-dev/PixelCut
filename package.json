{
  "name": "pixelcut-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on -d 1000 -t 30000 http://localhost:3000 && electron .\"",
    "desktop:build": "npm run build && electron-builder",
    "desktop:pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.pixelcut.studio",
    "productName": "PixelCut",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "acaro",
        "repo": "PixelCut"
      }
    ],
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "acaro",
          "repo": "PixelCut"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixelCut"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "geist": "^1.7.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.1",
    "next": "16.3.8",
    "pixelmatch": "^7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
